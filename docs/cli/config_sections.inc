     - *config file only*

.. code-block:: ini

    [save-images]
    # Folder to output videos. Overrides [global] output option.
    #output = /usr/tmp/images

    # Filename format of created images. Can use $VIDEO_NAME, $SCENE_NUMBER, $IMAGE_NUMBER,
    # $TIMECODE, $FRAME_NUMBER, and $TIMESTAMP_MS. Should not include extension.
    #filename = $VIDEO_NAME-Scene-$SCENE_NUMBER-$IMAGE_NUMBER

    # Image format (jpeg, png, webp).
    #format = jpeg

    # Number of images to generate for each scene. Cannot be used with interval.
    #num-images = 3

    # Generate one image per DURATION of each scene instead of num-images, so longer
    # scenes get more images: floor(length / DURATION) + 1 per scene. DURATION accepts
    # frames (24), seconds with `s` suffix (1.5s), or timecode (00:00:01.500).
    # Cannot be used with num-images.
    #interval = 2s

    # Minimum and maximum number of images per scene with interval (ignored without
    # interval). Set max-images to 0 for no limit.
    #min-images = 1
    #max-images = 0

    # Image quality (jpeg/webp). Default is 95 for jpeg, 100 for webp
    #quality = 95

    # Compression amount for png images (0 to 9). Only affects size, not quality.
    #compression = 3

    # Padding around each scene cut when selecting frames. Accepts a number of frames (1),
    # seconds with `s` suffix (0.1s), or timecode (00:00:00.100).
    #frame-margin = 1

    # Resize by scale factor (0.5 = half, 1.0 = same, 2.0 = double).
    #scale = 1.0

    # Resize to specified height, width, or both. Mutually exclusive with scale.
    #height = 0
    #width = 0

    # Method to use for scaling (nearest, linear, cubic, area, lanczos4).
    #scale-method = linear

    # Use separate threads for encoding and disk IO. Can improve performance.
    #threading = yes

